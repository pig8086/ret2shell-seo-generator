# PostgreSQL DSN. The role only needs SELECT on article and game.
DATABASE_URL=postgresql://ret2shell:change-me@127.0.0.1:5432/ret2shell

# Canonical public origin, no trailing slash required.
SITE_URL=https://ctf.example.com

# Feed/site metadata.
SITE_NAME=Ret2Shell
SITE_DESCRIPTION=A feature-riches CTF challenge platform.
SITE_LANGUAGE=zh-CN

# Maximum number of RSS items.
FEED_LIMIT=30

# Where sitemap.xml and rss.xml are written.
SEO_OUTPUT_DIR=./output

# Static entries included in the sitemap.
SEO_STATIC_PATHS=/,/wiki,/bulletin,/games

# Optional: game bucket root. When set, the generator reads
# <BUCKET_PATH>/<game.bucket>/README.md before falling back to the article table.
# BUCKET_PATH=/var/lib/ret2shell/bucket
